{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "st-sqlite-helper": ["../../release/st-sqlite-helper/types/sqlite-helper.d.ts"],
      "st-sqlite-helper/dvs": ["../../release/st-sqlite-helper/types/dvs.d.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["状态栏/**/*.ts", "状态栏/**/*.vue", "生成拦截/**/*.ts", "生成拦截/**/*.vue"]
}
